@model HangHoa
@{
    ViewData["Title"] = "Thêm hàng hóa";
}

<div class="content_top">
    <div class="heading">
        <h3>@txtc_241230671_2023.Helpers.AppInfo.HoTen</h3>
    </div>
    <div class="clear"></div>
</div>
<p>Thêm Hàng Hóa Mới</p>

<form asp-action="Create" method="post" class="form-hh">
    <div asp-validation-summary="ModelOnly" class="text-error"></div>

    <div class="form-row">
        <label asp-for="MaLoai"></label>
        <select asp-for="MaLoai" asp-items="(SelectList)ViewBag.MaLoai"></select>
        <span asp-validation-for="MaLoai" class="text-error"></span>
    </div>

    <div class="form-row">
        <label asp-for="TenHang"></label>
        <input asp-for="TenHang" />
        <span asp-validation-for="TenHang" class="text-error"></span>
    </div>

    <div class="form-row">
        <label asp-for="Gia"></label>
        <input asp-for="Gia" type="text" />
        <span asp-validation-for="Gia" class="text-error"></span>
    </div>

    <div class="form-row">
        <label asp-for="Anh"></label>
        <input asp-for="Anh" />
        <span asp-validation-for="Anh" class="text-error"></span>
    </div>

    <div class="form-row">
        <input type="submit" value="Create" />
        <a asp-action="Index">Quay lại</a>
    </div>
</form>