@model HangHoaListViewModel

<div class="content_top">
    <div class="heading">
        <h3>@Model.Title</h3>
    </div>
    <div class="see">
        <p><a asp-controller="Home" asp-action="Create">Thêm hàng hóa</a></p>
    </div>
    <div class="clear"></div>
</div>

<div class="section group">
    @foreach (var h in Model.DanhSach)
    {
        <div class="grid_1_of_4 images_1_of_4">
            <a href="#"><img src="~/images/@h.Anh" alt="@h.TenHang" /></a>
            <h2>@h.TenHang</h2>
            <div class="price-details">
                <div class="price-number">
                    <p><span class="rupees">@h.Gia?.ToString("0")</span></p>
                </div>
                <div class="add-cart">
                    <h4><a href="#">Add to Cart</a></h4>
                </div>
                <div class="clear"></div>
            </div>
        </div>
    }
</div>