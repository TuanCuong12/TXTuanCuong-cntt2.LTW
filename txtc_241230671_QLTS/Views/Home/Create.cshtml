@model TaiSan
@{
    ViewData["Title"] = "Thêm tài sản";
}

<div class="section-head"><h3>Thêm tài sản mới</h3></div>

<form asp-action="Create" method="post" class="form-box">
    <div asp-validation-summary="ModelOnly" class="text-error"></div>

    <div class="form-row">
        <label asp-for="MaLoai"></label>
        <select asp-for="MaLoai" asp-items="(SelectList)ViewBag.MaLoai">
            <option value="">-- Chọn loại tài sản --</option>
        </select>
        <span asp-validation-for="MaLoai" class="text-error"></span>
    </div>

    <div class="form-row">
        <label asp-for="TenTs"></label>
        <input asp-for="TenTs" />
        <span asp-validation-for="TenTs" class="text-error"></span>
    </div>

    <div class="form-row">
        <label asp-for="NguyenGia"></label>
        <input asp-for="NguyenGia" type="text" />
        <span asp-validation-for="NguyenGia" class="text-error"></span>
    </div>

    <div class="form-row">
        <label asp-for="Anh"></label>
        <input asp-for="Anh" placeholder="vd: Img_1.jpg" />
        <span asp-validation-for="Anh" class="text-error"></span>
    </div>

    <div class="form-row">
        <input type="submit" value="Create" class="btn-buy" />
        <a asp-action="Index" class="btn-back">Quay lại</a>
    </div>
</form>