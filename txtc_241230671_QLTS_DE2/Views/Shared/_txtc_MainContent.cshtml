@model TaiSanListViewModel

<div class="section-head">
    <h3>@Model.Title</h3>
</div>

@if (Model.DanhSach.Count == 0)
{
    <p class="empty">Chưa có tài sản nào.</p>
}
else
{
    <div class="grid">
        @foreach (var t in Model.DanhSach)
        {
            <div class="asset-card">
                <a href="#"><img src="~/images/@t.Anh" alt="@t.TenTs" /></a>
                <h2>@t.TenTs</h2>
                <div class="asset-foot">
                    <span class="price">@t.NguyenGia?.ToString("0") tr</span>
                    <a class="btn-buy" asp-controller="Home" asp-action="Edit" asp-route-id="@t.MaTs">Sửa</a>
                </div>
            </div>
        }
    </div>
}