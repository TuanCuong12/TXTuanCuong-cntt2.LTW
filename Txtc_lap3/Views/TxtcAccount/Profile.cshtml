@{
	ViewData["Title"] = "Profile";
	var account = ViewBag.Account as TxtcAccount;
}
<hr />
<h2>Your Profile</h2>
<div class="row">
	<div class="col-md-4">
		<img src="@account.Avatar" alt="Avatar" style="width: 100%; height: auto;">
	</div>
	<div class="col-md-8">
		<h2>Full Name: @account.Name</h2>
		<h3><strong>Email:</strong> @account.Email</h3>
		<h3><strong>Phone:</strong> @account.Phone</h3>
		<h3><strong>Address:</strong> @account.Address</h3>
		<h3><strong>Bio:</strong> @account.Bio</h3>
		<h3>Gender: 
			@if (account.Gender == 1) 
			{ 
				<text>Male</text> 
			} else 
			{ 
				<text>Female</text>
			}
			</h3>
		<h3><strong>Birthday:</strong> @account.Birthday.ToString("dd/MM/yyyy")</h3>
		<p>
			<a asp-controller="TxtcAccount" asp-action="Index" class="btn btn-sm btn-danger">Back to list</a>
		</p>
	</div>
</div>
