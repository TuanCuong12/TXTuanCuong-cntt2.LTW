@model SachListViewModel

<div class="section-head">
    <h3>@Model.Title</h3>
    <a asp-controller="Home" asp-action="Create">Thêm sách &rsaquo;</a>
</div>

@if (Model.DanhSach.Count == 0)
{
    <p class="empty">Chưa có sách nào.</p>
}
else
{
    <div class="grid">
        @foreach (var s in Model.DanhSach)
        {
            <div class="book-card">
                <a href="#"><img src="~/images/@s.Anh" alt="@s.TenSach" /></a>
                <h2>@s.TenSach</h2>
                <div class="book-foot">
                    <span class="price">@s.Gia?.ToString("0")</span>
                    <button class="btn-buy">Thêm vào giỏ</button>
                </div>
            </div>
        }
    </div>
}